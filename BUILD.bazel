load("@rules_cc//cc:cc_shared_library.bzl", "cc_shared_library")

# Standalone logging library. Include root is the repository root; public headers live
# under include/ (e.g. #include "include/logging.h", "include/logger/logger.h").
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_pkg//pkg:install.bzl", "pkg_install")
load("@rules_pkg//pkg:pkg.bzl", "pkg_tar")
load("//bazel:distribution.bzl", "logging_distribution", "shared_consumer")
load("//bazel:logging.bzl", "logging_copts", "logging_defines", "logging_linkopts")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "logging_hdrs",
    srcs = glob(
        [
            "include/*.h",
            "include/common/*.h",
            "include/util/*.h",
            "include/logger/*.h",
            "include/backend/*.h",
        ],
        allow_empty = True,
    ),
)

filegroup(
    name = "logging_srcs",
    # Implementation lives under src/ (mirrors CMakeLists.txt). The per-backend
    # files are compile-time guarded, so globbing all of them is safe.
    srcs = glob(
        [
            "src/*.cpp",
            "src/backend/*.cpp",
        ],
        allow_empty = True,
    ),
)

cc_library(
    name = "logging_lib",
    srcs = [
        ":logging_srcs",
    ],
    hdrs = [":logging_hdrs"],
    copts = logging_copts(),
    defines = logging_defines() + select({
        "//bazel:shared_libs": ["LOGGING_SHARED_DEFINE"],
        "//conditions:default": ["LOGGING_STATIC_DEFINE"],
    }),
    # No "." in includes: the package is the workspace root, so Bazel's default
    # -iquote <workspace_root> already resolves "include/common/..." and "include/util/..."
    # headers (includes = ["."] is rejected at the workspace root by Bazel 8+).
    # "include/logger" stays: sources include its headers by bare name (e.g.
    # "logger_verbosity_enum.h" from within include/logger/logger.h itself).
    includes = [
        "include/logger",
    ],
    linkopts = logging_linkopts() + select({
        "@platforms//os:windows": ["dbghelp.lib"],
        "//conditions:default": [],
    }),
    # Shared output is produced explicitly by logging_shared below.
    linkstatic = True,
    local_defines = select({
        "//bazel:shared_libs": ["LOGGING_BUILDING_DLL"],
        "//conditions:default": [],
    }),
    visibility = [
        "//visibility:public",
    ],
    deps = [
        "@fmt",
        "@magic_enum",
    ] + select({
        "//bazel:logging_glog": ["@glog"],
        "//bazel:logging_loguru": ["@loguru"],
        "//bazel:logging_native": [],
        "//bazel:logging_spdlog": ["@spdlog"],
        "//conditions:default": ["@loguru"],
    }),
    alwayslink = False,
)

alias(
    name = "Logging",
    actual = select({
        "//bazel:shared_libs": ":logging_dynamic",
        "//conditions:default": ":logging_lib",
    }),
    visibility = ["//visibility:public"],
)

cc_shared_library(
    name = "logging_shared",
    shared_lib_name = select({
        "@platforms//os:windows": "Logging.dll",
        "@platforms//os:macos": "libLogging.dylib",
        "//conditions:default": "libLogging.so",
    }),
    tags = ["manual"],
    deps = [":logging_lib"],
)

shared_consumer(
    name = "logging_dynamic",
    library = ":logging_lib",
    shared = ":logging_shared",
    tags = ["manual"],
)

# =============================================================================
# Install / export (bazel-side analogue of CMake's `install(TARGETS Logging
# ...)` / `install(DIRECTORY include/ DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}
# ...)`). CMake installs include/'s *contents* flattened directly under
# <prefix>/include (common/, logger/, util/, backend/, logging.h) -- not
# nested under an extra "Logging/include/" -- so the Bazel destination
# mirrors that same flattened "include" prefix.
# `bazel build //:logging_pkg_tar` produces a relocatable tarball; `bazel run
# //:install -- --destdir=/some/prefix` stages the same tree directly on disk.
# =============================================================================

logging_distribution(
    name = "logging_distribution",
    headers = [":logging_hdrs"],
    library = select({
        "//bazel:shared_libs": ":logging_shared",
        "//conditions:default": ":logging_lib",
    }),
    license = "LICENSE",
    macos = select({
        "@platforms//os:macos": True,
        "//conditions:default": False,
    }),
    magic_enum = "@magic_enum//:magic_enum",
    magic_enum_license = "@magic_enum//:LICENSE",
    shared = select({
        "//bazel:shared_libs": True,
        "//conditions:default": False,
    }),
    standard = select({
        "//bazel:cxx17": "17",
        "//bazel:cxx23": "23",
        "//conditions:default": "20",
    }),
    third_party_licenses = select({
        "//bazel:logging_glog": {
            "@fmt//:LICENSE": "fmt.LICENSE",
            "@glog//:COPYING": "glog.LICENSE",
            "@gflags//:COPYING.txt": "gflags.LICENSE",
        },
        "//bazel:logging_native": {"@fmt//:LICENSE": "fmt.LICENSE"},
        "//bazel:logging_spdlog": {
            "@fmt//:LICENSE": "fmt.LICENSE",
            "@spdlog//:LICENSE": "spdlog.LICENSE",
        },
        "//conditions:default": {
            "@fmt//:LICENSE": "fmt.LICENSE",
            "@loguru//:LICENSE": "loguru.LICENSE",
        },
    }),
    windows = select({
        "@platforms//os:windows": True,
        "//conditions:default": False,
    }),
    implementation = ":logging_lib",
)

pkg_tar(
    name = "logging_pkg_tar",
    srcs = [
        ":logging_distribution",
    ],
)

pkg_install(
    name = "install",
    srcs = [
        ":logging_distribution",
    ],
)
