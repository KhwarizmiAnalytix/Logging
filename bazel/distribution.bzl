"""Shared-library consumer adapter and relocatable installation mappings."""

load("@rules_cc//cc/common:cc_common.bzl", "cc_common")
load("@rules_cc//cc/common:cc_info.bzl", "CcInfo")
load("@rules_cc//cc/common:cc_shared_library_info.bzl", "CcSharedLibraryInfo")
load("@rules_pkg//pkg:providers.bzl", "PackageFilesInfo")

def _shared_consumer_impl(ctx):
    # Publish only the shared linker input, so even a linkstatic=True binary
    # cannot select objects compiled with the Windows DLL export definitions.
    shared = ctx.attr.shared
    return [
        shared[DefaultInfo],
        CcInfo(
            compilation_context = ctx.attr.library[CcInfo].compilation_context,
            linking_context = cc_common.create_linking_context(
                linker_inputs = depset([shared[CcSharedLibraryInfo].linker_input]),
            ),
        ),
    ]

shared_consumer = rule(
    implementation = _shared_consumer_impl,
    attrs = {
        "library": attr.label(providers = [CcInfo]),
        "shared": attr.label(providers = [CcSharedLibraryInfo]),
    },
)

def _distribution_impl(ctx):
    files = {}
    for header in ctx.files.headers:
        relative = header.short_path
        if relative.startswith("../"):
            relative = relative.split("/", 2)[2]
        if not relative.startswith("include/"):
            fail("Expected a project header under include/, got %s" % header)
        files[relative] = header
    for header in ctx.attr.magic_enum[CcInfo].compilation_context.headers.to_list():
        if "/include/magic_enum/" in header.path and header.basename.endswith(".hpp"):
            files["include/magic_enum/" + header.basename] = header

    libraries = ctx.attr.library[DefaultInfo].files.to_list()
    if len(libraries) != 1:
        fail("Expected exactly one installation library, got %s" % libraries)
    library = libraries[0]
    windows = ctx.attr.windows
    shared = ctx.attr.shared
    filename = "Logging.lib" if windows else "libLogging.a"
    if shared:
        filename = "Logging.dll" if windows else ("libLogging.dylib" if ctx.attr.macos else "libLogging.so")
    destination = ("bin/" if windows and shared else "lib/") + filename
    files[destination] = library

    properties = [
        '  IMPORTED_LOCATION "${_logging_prefix}/%s"' % destination,
        '  INTERFACE_INCLUDE_DIRECTORIES "${_logging_prefix};${_logging_prefix}/include;${_logging_prefix}/include/logger"',
        '  INTERFACE_COMPILE_FEATURES "cxx_std_%s"' % ctx.attr.standard,
    ]
    defines = [d for d in ctx.attr.implementation[CcInfo].compilation_context.defines.to_list() if d.startswith("LOGGING_")]
    properties.append('  INTERFACE_COMPILE_DEFINITIONS "%s"' % ";".join(defines))
    if windows and shared:
        interface = ctx.attr.library[OutputGroupInfo].interface_library.to_list()[0]
        files["lib/Logging.lib"] = interface
        properties.append('  IMPORTED_IMPLIB "${_logging_prefix}/lib/Logging.lib"')
    if not shared:
        flags = []
        dependencies = []
        for linker_input in ctx.attr.implementation[CcInfo].linking_context.linker_inputs.to_list():
            for dependency in linker_input.libraries:
                if linker_input.owner == ctx.attr.implementation.label:
                    continue
                archive = dependency.pic_static_library or dependency.static_library
                if archive and archive != library:
                    path = "lib/logging-deps/" + archive.basename
                    if path in files and files[path] != archive:
                        fail("Conflicting dependency archives: %s" % path)
                    files[path] = archive
                    entry = "${_logging_prefix}/" + path
                    if entry not in dependencies:
                        dependencies.append(entry)
            for flag in linker_input.user_link_flags:
                if flag not in flags:
                    flags.append(flag)
        properties.append('  INTERFACE_LINK_LIBRARIES "%s"' % ";".join(dependencies + flags))

    config = ctx.actions.declare_file(ctx.label.name + "/LoggingConfig.cmake")
    ctx.actions.write(config, "\n".join([
        "# Generated by Logging's Bazel distribution rule. Relocatable with the installation tree.",
        "if(TARGET Logging::Logging)",
        "  return()",
        "endif()",
        'get_filename_component(_logging_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)',
        "add_library(Logging::Logging %s IMPORTED)" % ("SHARED" if shared else "STATIC"),
        "set_target_properties(Logging::Logging PROPERTIES",
    ] + properties + [")", "unset(_logging_prefix)", ""]))
    files["lib/cmake/Logging/LoggingConfig.cmake"] = config
    files["share/licenses/Logging/LICENSE"] = ctx.file.license
    files["share/licenses/Logging/magic_enum.LICENSE"] = ctx.file.magic_enum_license
    for target, name in ctx.attr.third_party_licenses.items():
        files["share/licenses/Logging/" + name] = target[DefaultInfo].files.to_list()[0]
    return [
        DefaultInfo(files = depset(files.values())),
        PackageFilesInfo(dest_src_map = files, attributes = {"mode": "0644"}),
    ]

logging_distribution = rule(
    implementation = _distribution_impl,
    attrs = {
        "headers": attr.label_list(allow_files = True),
        "magic_enum": attr.label(providers = [CcInfo]),
        "library": attr.label(),
        "implementation": attr.label(providers = [CcInfo]),
        "license": attr.label(allow_single_file = True),
        "magic_enum_license": attr.label(allow_single_file = True),
        "third_party_licenses": attr.label_keyed_string_dict(allow_files = True),
        "shared": attr.bool(),
        "windows": attr.bool(),
        "macos": attr.bool(),
        "standard": attr.string(),
    },
)
